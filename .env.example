# Selects config/<APP_ENV>.toml (default: local)
APP_ENV=local

# --- Top level ---
APP_PUBLIC_URL=http://localhost:8080
APP_DATA_DIR=data

# --- Server ---
APP_SERVER__HOST=127.0.0.1
APP_SERVER__PORT=8080
# APP_SERVER__SECURE_COOKIE=false
APP_SERVER__CSP=report_only

# --- Database ---
APP_DATABASE__URL=sqlite://data/db/app.db
APP_DATABASE__READ_CONNECTIONS=8
APP_DATABASE__BUSY_TIMEOUT_SECS=5
APP_DATABASE__SLOW_QUERY_MS=250

# --- Mail (leave SMTP unset to log mail to the console) ---
# APP_MAIL__FROM="Web Archiver <noreply@example.com>"
# APP_MAIL__SMTP__HOST=smtp.example.com
# APP_MAIL__SMTP__PORT=587
# APP_MAIL__SMTP__USERNAME=smtp-user
# APP_MAIL__SMTP__PASSWORD=change-me
# APP_MAIL__SMTP__STARTTLS=true
# APP_MAIL__SMTP__ACCEPT_INVALID_CERTS=false

APP_SERVER__TRUSTED_PROXIES=127.0.0.1/32,::1/128
